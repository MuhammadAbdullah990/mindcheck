# Client configuration. Vite only exposes variables prefixed with VITE_.
# This file is optional in development — the client falls back to
# http://localhost:3001/api when VITE_API_URL is unset.

# Base URL of the MindCheck API, including the /api prefix.
# Local:  http://localhost:3001/api
# Prod:   https://mindcheck-api.onrender.com/api
VITE_API_URL=http://localhost:3001/api

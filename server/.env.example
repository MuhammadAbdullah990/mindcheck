# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (Neon) ──────────────────────────────────────────────────────
# Neon dashboard → Connection Details → Pooled connection
# Use the POOLED (-pooler) host for everything. `prisma migrate` works against
# it too; the only reason to reach for the direct host is debugging a migration
# that times out on the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/mindcheck?sslmode=require"

# ─── Auth ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-random-48-byte-hex-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
